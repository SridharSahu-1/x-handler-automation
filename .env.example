# --- Core ---
APP_URL=https://your-app.vercel.app
CRON_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string
DASHBOARD_PASSWORD=fallback-login-password
DRY_RUN=1                       # 1 = never post to X, only Telegram/dashboard

# --- Database (Neon via Vercel Marketplace) ---
DATABASE_URL=postgres://...

# --- Vercel Blob (create a PUBLIC store: Buffer and Telegram must be able to fetch the images) ---
BLOB_READ_WRITE_TOKEN=

# --- Posting to X: pick ONE. The app uses the first that's configured (PUBLISHER overrides). ---
# Free, automatic: connect your X account at buffer.com (free plan), then Settings → API → create a key.
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=              # optional; defaults to your first connected X channel
# Free, no accounts: leave everything here empty. Telegram hands you each approved post and you tap Post.
# Paid (~$0.015/post), also edits your profile: X developer app, OAuth 1.0a user keys.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
PUBLISHER=                      # optional: xapi | buffer | manual

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # without @, used by the dashboard login widget
TELEGRAM_CHAT_ID=               # your private chat id with the bot (bot obeys only this)
TELEGRAM_WEBHOOK_SECRET=generate-random-string

# --- LLMs (free tiers). Model ids are env so retired models are a 1-line change ---
GOOGLE_GENERATIVE_AI_API_KEY=
# *_MODEL takes a comma list (fallback order); free tiers meter each model separately.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# --- Search (free tiers; any subset works, chain order = this order) ---
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=                   # optional, raises Jina Reader rate limits
